{
  "name": "browser-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for managing multiple browsers (Firefox, Chromium, Edge, Safari, Tor) in headed and headless modes",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "browser-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "install-browsers": "npx playwright install --with-deps"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "playwright": "^1.49.0",
    "playwright-core": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
